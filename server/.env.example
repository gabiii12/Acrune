# Copy this file to .env and fill in your values. Never commit .env.

# --- Providers (a provider is enabled when its API key is set) ---
ZSMM_API_KEY=your-zsmm-api-key
GROWIX_API_KEY=your-growix-api-key
# Optional per provider: ZSMM_API_URL, ZSMM_MULTIPLIER, GROWIX_API_URL, GROWIX_MULTIPLIER

# --- Pricing ---
# 1 = customers pay the provider price. 1.2 = 20% markup.
PRICE_MULTIPLIER=1
# Only used if a provider bills in USD instead of PHP.
USD_TO_PHP=58

# --- Admin ---
# At least 8 characters. Changing it logs out every admin session.
ADMIN_PASSWORD=change-me-please
# Optional extra secret for signing admin logins.
ADMIN_SECRET=

# --- GCash (shown to customers on the payment step) ---
GCASH_NUMBER=09XXXXXXXXX
GCASH_NAME=Your Name

# --- Server ---
PORT=3001
# Set to 1 when hosted behind a proxy (Render, Railway, nginx) so rate limits see real IPs.
TRUST_PROXY=
